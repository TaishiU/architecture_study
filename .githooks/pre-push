#!/bin/sh

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 1. テストを実行
echo "🧪 flutter test 実行中..."
TEST_OUTPUT=$(flutter test --coverage 2>&1)
TEST_EXIT=$?
printf '%s\n' "$TEST_OUTPUT"

if [ "$TEST_EXIT" -ne 0 ]; then
  printf "${RED} ❌ テストが失敗しています。修正してから再度pushしてください。\n"
  exit 1
fi
printf "${GREEN} ✅ テスト全件通過\n"

# 2. lcov / genhtml の存在確認
if ! command -v lcov >/dev/null 2>&1 || ! command -v genhtml >/dev/null 2>&1; then
  printf "${YELLOW} ⚠️  lcov / genhtml が見つかりません。以下のコマンドでインストールしてください:\n"
  printf "    brew install lcov\n\n"
  printf "インストール後に再度pushしてください。\n"
  exit 1
fi

# 3. カバレッジ抽出（対象: repository / service_impl / api_client / view_model）
lcov --extract coverage/lcov.info 'lib/data/**/*_repository.dart' \
  --extract coverage/lcov.info 'lib/data/**/*_service_impl.dart' \
  --extract coverage/lcov.info 'lib/data/**/api_client.dart' \
  --extract coverage/lcov.info 'lib/ui/**/*_view_model.dart' \
  -o coverage/lcov_extract.info 2>/dev/null

# 自動生成ファイルを除外
lcov --remove coverage/lcov_extract.info 'lib/**/*.g.dart' \
  --remove coverage/lcov_extract.info 'lib/**/*.freezed.dart' \
  -o coverage/lcov_extract.info 2>/dev/null

# 4. カバレッジ 100% チェック
LINES_FOUND=$(grep '^LF:' coverage/lcov_extract.info | awk -F: '{s+=$2}END{print s+0}')
LINES_HIT=$(grep '^LH:' coverage/lcov_extract.info | awk -F: '{s+=$2}END{print s+0}')

if [ "$LINES_FOUND" -eq 0 ]; then
  printf "${YELLOW} ⚠️  カバレッジ対象ファイルが見つかりません。\n"
  exit 1
fi

if [ "$LINES_HIT" -lt "$LINES_FOUND" ]; then
  UNCOVERED=$((LINES_FOUND - LINES_HIT))
  COVERAGE_PCT=$(awk "BEGIN {printf \"%.1f\", ($LINES_HIT/$LINES_FOUND)*100}")
  printf "${RED} ❌ カバレッジが100%%未満です（${COVERAGE_PCT}%% / 未カバー行: ${UNCOVERED}件）\n\n"
  printf "未カバーのファイル:\n"
  awk -F: '
    /^SF:/ { file = $2 }
    /^LF:/ { lf = $2 }
    /^LH:/ { lh = $2; if (lh + 0 < lf + 0) printf "  %s (%d/%d行)\n", file, lh, lf }
  ' coverage/lcov_extract.info
  printf "\n上記ファイルのテストカバレッジを100%%にしてから再度pushしてください。\n"
  exit 1
fi

printf "${GREEN} ✅ カバレッジ 100%%\n"

# 5. HTML生成 & ブラウザで確認
genhtml coverage/lcov_extract.info -o coverage/html 2>/dev/null
open coverage/html/index.html

printf "\nブラウザでカバレッジレポートを確認してください。\n"
printf "カバレッジを確認しました。pushを続行しますか？ [y/N]: "
read -r ANSWER </dev/tty
case "$ANSWER" in
  [yY]) echo "🚀 pushを続行します。" ;;
  *) echo "push をキャンセルしました。"; exit 1 ;;
esac
